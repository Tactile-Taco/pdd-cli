{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "response.schema.json",
  "title": "PublishResponse",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["published", "already-published", "error"]
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "bundle_digest": {
      "type": "string"
    },
    "evidence_digest": {
      "type": "string"
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": ["invalid_request", "unauthorized", "conflict", "internal"]
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["code", "message"]
    }
  },
  "required": ["status"]
}
